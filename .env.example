APP_NAME="Plant Land"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_SYNC=false

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE=""
DB_USERNAME=""
DB_PASSWORD=""

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER="sendmail"
MAIL_HOST="smtp.mailtrap.io"
MAIL_PORT="2525"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Super admin account created by `php artisan db:seed` (see database/seeds/SuperAdminSeeder.php).
# Leave ADMIN_PASSWORD unset to have a strong random password generated and
# printed once at seed time instead of stored in this file.
ADMIN_NAME="Super Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Licensing gate - see App\Services\LicenseService and docs/LICENSING.md.
# Leave LICENSE_ENDPOINT/APP_ID/TOKEN/SECRET unset to disable the check
# entirely (app runs ungated). LICENSE_OVERRIDE_HASH is generated per
# deployment via `php artisan license:generate-override-code` - never
# reuse one across multiple projects.
LICENSE_ENDPOINT=
LICENSE_APP_ID=
LICENSE_TOKEN=
LICENSE_SECRET=
LICENSE_OVERRIDE_HASH=
